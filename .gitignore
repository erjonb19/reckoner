# Data — hospital MRFs and payer TiC files are tens of MB to 1 TB+.
# ADLS Gen2 is authoritative; nothing large lands in git.
data/
raw/
curated/
scratch/
*.parquet
*.zip
*.gz
*.7z
*.tar

# Downloaded source files
*.mrf.json
*.tic.json

# ...but small, checked-in parser test fixtures are the exception.
# Parsers are tested against real files, so keep trimmed samples.
!tests/fixtures/**

